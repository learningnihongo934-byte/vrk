{
  "hosting": {
    "site": "vrkweb",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/install", "destination": "/install.sh" },
      { "source": "/install-windows", "destination": "/install.ps1" }
    ],
    "headers": [
      { "source": "/install.*", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "no-cache" }] },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self' https://virat-kaukuntla.web.app; base-uri 'none'; form-action 'none'" }
        ]
      }
    ]
  }
}
